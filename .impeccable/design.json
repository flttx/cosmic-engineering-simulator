  "narrative": {
    "northStar": "宇宙工程观察窗",
    "overview": "沿用用户批准的 v0.8 方向：偏写实、克制的硬科幻工业结构。宏大尺度、空间结构、工业细节和稳定尺度参照提供体验；界面以低亮度信息面和精简文字附着在观察区域边缘。\n\n中文信息优先。深色背景延续宇宙环境，暖金色负责选中、聚焦和操作反馈。文档记录当前实现的视觉规范，不代表近景资产、美术、性能或完整视觉验收已通过。",
    "keyCharacteristics": [
      "真实三维场景主导视野。",
      "深色信息面、细边界和小圆角。",
      "单一暖色表达选择与操作状态。",
      "讲解、科学边界和教学比例明确可见。"
    ],
    "rules": [
      {
        "name": "The Selection Signal Rule",
        "body": "暖金色优先用于可操作和已选中的语义，同一状态在导航、图层和对象检查中保持一致。",
        "section": "colors"
      },
      {
        "name": "The Scene Leads Rule",
        "body": "空间深度由三维结构、光照和视差承担；界面层次只帮助阅读与操作，不替代场景的尺度感。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 让真实三维结构、视差和尺度参照主导体验。",
      "**Do** 复用现有字体、暖金状态色、暗色信息面和细边界。",
      "**Do** 为按钮和字段提供名称、键盘操作与可见焦点。",
      "**Do** 保留中文科学边界、教学比例和真实加载状态。"
    ],
    "donts": [
      "**Don't** 用真空浓雾、装饰性发光或大型界面装饰替代结构与尺度感。",
      "**Don't** 将未验收的模型、美术或运行测量描述成已通过。",
      "**Don't** 添加建造、资源、经济、评分、解锁或任务入口。",
      "**Don't** 隐藏失败状态、键盘焦点或界面恢复入口。"
    ]
  }
}
