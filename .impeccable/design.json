      "html": "<button class=\"ds-icon\" aria-label=\"聚焦\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M4 9V4h5m6 0h5v5m0 6v5h-5M9 20H4v-5\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg></button>",
      "css": ".ds-icon{font-family:Barlow,\"Microsoft YaHei\",sans-serif;display:inline-flex;align-items:center;justify-content:center;height:40px;width:40px;border:0;border-radius:6px;background:none;color:#e5e7e9;cursor:pointer}.ds-icon:hover{background:#ffffff09;color:var(--accent,#e9bc81)}.ds-icon:focus-visible{outline-offset:4px;outline:2px solid var(--accent,#e9bc81);}@media(max-width:700px){.ds-icon{width:36px}}"
    },
    {
      "name": "教学图层列表",
      "kind": "custom",
      "refersTo": "layer-option",
      "description": "展开工具面后的纵向图层开关。",
      "html": "<div class=\"ds-layers\" aria-label=\"教学图层\"><button aria-pressed=\"false\"><span>轨道路径</span><span class=\"ds-layer-state\" aria-hidden=\"true\">关闭</span></button><button aria-pressed=\"true\"><span>能量采集</span><span class=\"ds-layer-state\" aria-hidden=\"true\">开启</span></button></div>",
      "css": ".ds-layers{font-family:Barlow,\"Microsoft YaHei\",sans-serif;display:flex;flex-direction:column;background:#111820f7;color:#e5e7e9;padding:20px;border:1px solid var(--line,#2d3540);border-radius:10px;width:336px}.ds-layers button{font-family:Barlow,\"Microsoft YaHei\",sans-serif;display:flex;align-items:center;justify-content:space-between;min-height:46px;padding:10px 0;border:0;border-bottom:1px solid #ffffff10;background:none;color:inherit;font-size:13px;text-align:left;cursor:pointer}.ds-layers button:last-child{border:0}.ds-layer-state{font-size:11px;color:var(--muted,#a6b2bf)}.ds-layers button[aria-pressed=true],.ds-layers button[aria-pressed=true] .ds-layer-state,.ds-layers button:hover{color:var(--accent,#e9bc81)}.ds-layers button:focus-visible{outline-offset:4px;outline:2px solid var(--accent,#e9bc81);}@media(max-width:1000px){.ds-layers{width:320px}}@media(max-width:700px){.ds-layers{width:calc(100% - 36px);max-width:340px}}"
    },
