      "html": "<aside class=\"ds-inspector\" aria-label=\"对象与讲解\"><div class=\"ds-panel-tabs\"><button aria-pressed=\"true\">观察对象</button><button aria-pressed=\"false\">原理讲解</button></div><div class=\"ds-panel-body\"><h2>采能卫星</h2><p>工程结构与尺寸为概念化设计。</p></div></aside>",
      "css": ".ds-inspector{font-family:Barlow,\"Microsoft YaHei\",sans-serif;width:336px;background:#111820f7;border:1px solid var(--line,#2d3540);border-radius:10px;color:#e5e7e9;overflow:hidden;max-height:calc(100dvh - 218px)}.ds-panel-tabs{display:flex;border-bottom:1px solid var(--line,#2d3540);padding:5px 12px}.ds-panel-tabs button{font-family:Barlow,\"Microsoft YaHei\",sans-serif;background:none;border:0;min-height:40px;padding:12px 10px;font-size:12px;color:#b4c0cb;cursor:pointer}.ds-panel-tabs button[aria-pressed=true],.ds-panel-tabs button:hover{color:var(--accent,#e9bc81)}.ds-panel-tabs button:focus-visible{outline-offset:4px;outline:2px solid var(--accent,#e9bc81);}.ds-panel-body{padding:22px;overflow-y:auto;max-height:calc(100dvh - 274px)}.ds-panel-body h2{font-size:18px;line-height:1.5;font-weight:500;margin:0}.ds-panel-body p{font-size:13px;line-height:1.9;color:#c3cdd5}@media(max-width:1000px){.ds-inspector{width:320px}}@media(max-width:700px){.ds-inspector{width:calc(100% - 36px);max-width:340px;max-height:calc(100dvh - 234px)}.ds-panel-body{padding:18px;max-height:calc(100dvh - 292px)}.ds-panel-body p{font-size:12px}}"
