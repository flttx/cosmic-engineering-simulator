  "narration": [
    {
      "id": "what_is_swarm",
      "title": "01 / 戴森群是什么",
      "text": "戴森群由大量彼此独立的绕星设施构成。1960 年 Dyson 提出了搜索人工恒星红外辐射的设想；当前结构采用概念化的离散群体布局，没有已建成的戴森群证据。",
      "focusId": "sun",
      "overlays": [
        "orbits"
      ]
    },
    {
      "id": "satellite_structure",
      "title": "02 / 看懂一颗卫星",
      "text": "聚焦代表卫星，分别选择采能面、桁架、散热器和姿态模块。维护参照物帮助理解视觉尺度；所有局部尺寸均为示意，隔离和爆炸视图用于观察连接关系。",
      "focusId": "collector_hero",
      "overlays": [
        "energy",
        "heat",
        "labels"
      ]
    },
    {
      "id": "orbit_motion",
      "title": "03 / 独立轨道运动",
      "text": "每颗卫星沿自己的轨道移动。暂停或单步观察群体变化。演示使用固定轨道和压缩时间，不是经过碰撞验证的部署方案，也不进行多体引力计算。",
      "focusId": "orbit_family_north",
      "overlays": [
        "orbits"
      ]
    },
    {
      "id": "planet_light",
      "title": "04 / 行星的视线",
      "text": "行星视线图层展示观察方向以及设施可能经过视线的位置。它不计算遮挡率、行星气候或实际光照变化；采能和废热图层同样只是路径示意。",
      "focusId": "sun",
      "overlays": [
        "light",
        "energy"
      ]
    },
    {
      "id": "scientific_limits",
      "title": "05 / 科学与外推",
      "text": "恒星核聚变与向外辐射有观测基础；巨型采能设施的制造、轨道管理和散热体系仍是工程外推。S2 标签保留为待核验分类。此演示不提供虚构的精确尺寸、效率或成本。",
      "focusId": "radiator",
      "overlays": [
        "heat"
      ]
    }
  ],
